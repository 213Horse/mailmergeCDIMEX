## Runtime configuration (used by PROD_ENV_FILE on GitHub Secrets)
## Copy this file and replace values, then paste full content into GitHub secret: PROD_ENV_FILE

# Streamlit
STREAMLIT_SERVER_PORT=6520

# Mail sending (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_SSL=false

FROM_NAME=Cdimex
DEFAULT_SUBJECT=Kết quả bài thi Versant Professional English Test  - {{Ten}}

# App defaults
DRY_RUN_DEFAULT=true
RATE_DELAY_DEFAULT=1.5

